# Copy to .env for a NEW deployment database, or set in your hosting dashboard.
# Do not overwrite an existing local .env containing your development settings.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-random-secret
FRONTEND_URL=https://YOUR_GITHUB_USERNAME.github.io
BACKEND_URL=https://YOUR_RENDER_SERVICE.onrender.com
REQUIRE_EMAIL_VERIFICATION=true
OPENAI_API_KEY=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SelfGlow
# Optional: weather personalization. The app still works without it.
OPENWEATHER_API_KEY=
